# EE store database. Add your MongoDB Atlas connection string here when ready.
MONGODB_URI=
MONGODB_DB=ee_store

# Web admin credentials. No defaults are shipped in the repository.
WEB_ADMIN_USERNAME=
WEB_ADMIN_PASSWORD=
# Use a random secret with at least 32 characters.
WEB_ADMIN_SECRET=

# Telegram bot configuration (shared with the existing Telegram admin workflow).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Optional AI image tooling.
MODEL_API_KEY=
